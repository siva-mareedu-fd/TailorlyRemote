{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tailoring hallucination eval set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "items", "adversarial", "benign"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "labelSource", "paragraphs", "confirmedSkills", "job", "gaps", "forbidden"],
        "properties": {
          "id": { "type": "string", "pattern": "^t[0-9]{2}$" },
          "labelSource": { "type": "string", "minLength": 1 },
          "notes": { "type": ["string", "null"] },
          "paragraphs": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "section", "text", "editable"],
              "properties": {
                "id": { "type": "string", "pattern": "^p[0-9]{1,3}$" },
                "section": { "type": "string", "enum": ["contact", "summary", "experience", "skills", "education", "projects", "certifications", "other"] },
                "text": { "type": "string", "minLength": 1 },
                "editable": { "type": "boolean" },
                "bullet": { "type": "boolean" },
                "heading": { "type": "boolean" },
                "prefix": { "type": ["string", "null"] }
              }
            }
          },
          "confirmedSkills": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "job": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "company", "description", "skillsRequired", "skillsPreferred", "seniority", "yearsMin"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "company": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 100 },
              "skillsRequired": { "type": "array", "items": { "type": "string" } },
              "skillsPreferred": { "type": "array", "items": { "type": "string" } },
              "seniority": { "type": ["string", "null"] },
              "yearsMin": { "type": ["integer", "null"] }
            }
          },
          "gaps": { "type": "array", "items": { "type": "string" } },
          "forbidden": {
            "description": "Terms this candidate does not have (skills, employers, credentials, metrics). Any of them in an unflagged edit is a hallucination.",
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "adversarial": {
      "description": "Hand-written edits that add a fact; the guard must refuse or flag every one.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "paragraph", "newText", "kind"],
        "properties": {
          "item": { "type": "string" },
          "paragraph": { "type": "string" },
          "newText": { "type": "string" },
          "kind": { "type": "string", "enum": ["number", "skill", "employer", "title", "credential", "link", "metric"] }
        }
      }
    },
    "benign": {
      "description": "Hand-written rewordings that add no fact; the guard must neither refuse nor flag them.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "paragraph", "newText"],
        "properties": {
          "item": { "type": "string" },
          "paragraph": { "type": "string" },
          "newText": { "type": "string" }
        }
      }
    }
  }
}
