# Copy to deploy/.env and fill in. deploy/.env is gitignored; never commit real values.
# Keys follow PRD Appendix A (double underscore = nested config section).

# --- Compose ---
SITE_ADDRESS=localhost
POSTGRES_PASSWORD=
TAG=local
ASPNETCORE_ENVIRONMENT=Production

# --- AI: Fake (recorded fixtures, no key) or Anthropic (official SDK; needs a key) ---
Ai__Provider=Fake
Anthropic__ApiKey=
# Reasoning effort for every AI task (low|medium|high|max); per task: Ai__Tasks__resume_parse__Effort=medium
Ai__Effort=low
Ai__MaxConcurrentCalls=4

# --- Security ---
# HMAC key for consent IP hashes. Generate once: openssl rand -hex 32
Security__IpHashKey=

# --- Email (dev profile: Mailpit on mailpit:1025, UI http://localhost:8025) ---
Email__Provider=Smtp
Email__From=Tailorly Remote <no-reply@localhost>
Email__Smtp__Host=mailpit
Email__Smtp__Port=1025
Email__Smtp__Security=None
Email__Smtp__Username=
Email__Smtp__Password=

# --- Storage ---
Storage__Provider=Local
Storage__RootPath=/data/storage

# --- FX ---
Fx__Provider=Static
Fx__StaticRates__USD_INR=84.0

# --- Product limits ---
Signup__RequireInviteCode=false
Budgets__DiscoveryTokens=600000
Budgets__DocumentsTokens=1400000
Scoring__MaxPerRun=20
Tailor__MaxLengthRatio=1.15
Ai__PlatformDailyEnrichmentTokenCeiling=

# --- Job sources (M2) ---
# Poll intervals live in job_sources.poll_interval_minutes (seed: Himalayas 1440, others 360; edit in Admin → Sources).
Sources__UserAgent=TailorlyRemote/1.0 (+https://tailorly.example)
Sources__TimeoutSeconds=15
Sources__CircuitOpenMinutes=60
Sources__DefaultRequestsPerMinute=60
# Per source, e.g. Sources__greenhouse__RequestsPerMinute=120
# Optional Himalayas API key for higher limits (Bearer); leave empty for the shared public allowance.
Sources__Himalayas__ApiKey=
Fetch__MaxPagesPerRun=50
Fetch__FirstRunBackfillDays=14
Fetch__BoardBulkDetailThreshold=25

# --- Admin ---
# An account with this email is granted the Admin role by `--migrate` / `--seed` once it is registered.
Admin__BootstrapEmail=
