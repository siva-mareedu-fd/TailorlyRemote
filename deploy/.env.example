# Copy to deploy/.env and fill in. deploy/.env is gitignored; never commit real values.
# Keys follow PRD Appendix A (double underscore = nested config section).

# --- Compose ---
# Production VM: TAILORLY_PROD=1 makes the deploy scripts add docker-compose.prod.yml (registry images, limits),
# SITE_ADDRESS is the public domain (Caddy gets its certificate by ACME), IMAGE_REPO the registry CI pushes to.
SITE_ADDRESS=localhost
TAILORLY_PROD=0
IMAGE_REPO=ghcr.io/your-github-user
POSTGRES_PASSWORD=
TAG=local
ASPNETCORE_ENVIRONMENT=Production

# --- AI: Fake (recorded fixtures, no key) or Anthropic (official SDK; needs a key) ---
Ai__Provider=Fake
Anthropic__ApiKey=
# Reasoning effort for every AI task (low|medium|high|max); per task: Ai__Tasks__resume_parse__Effort=medium
Ai__Effort=low
Ai__MaxConcurrentCalls=4

# --- Security ---
# HMAC key for consent IP hashes. Generate once: openssl rand -hex 32
Security__IpHashKey=

# --- Email (dev profile: Mailpit on mailpit:1025, UI http://localhost:8025) ---
Email__Provider=Smtp
Email__From=Tailorly Remote <no-reply@localhost>
Email__Smtp__Host=mailpit
Email__Smtp__Port=1025
Email__Smtp__Security=None
Email__Smtp__Username=
Email__Smtp__Password=

# --- Storage ---
Storage__Provider=Local
Storage__RootPath=/data/storage

# --- FX ---
# Frankfurter (api.frankfurter.dev, daily rates, no key) for "≈ INR" and salary comparison; the static rate is the
# fallback when it cannot be reached. Use Static to stay offline.
Fx__Provider=Frankfurter
Fx__StaticRates__USD_INR=95.0

# --- Product limits ---
Signup__RequireInviteCode=false
Budgets__DiscoveryTokens=600000
Budgets__DocumentsTokens=1400000
Scoring__MaxPerRun=20
Tailor__MaxLengthRatio=1.15

# --- Tailoring and cover letters (M4) ---
Tailor__MaxEdits=25
Tailor__AllowFirstPerson=false
# ATS Match Score weights (PRD §8.2)
Ats__Weights__KeywordCoverage=0.35
Ats__Weights__RequirementsMatch=0.25
Ats__Weights__TitleSeniority=0.10
Ats__Weights__ExperienceRelevance=0.15
Ats__Weights__FormatHealth=0.15
# Word limit per cover-letter tone
CoverLetter__Tones__concise=180
CoverLetter__Tones__confident=250
# PDF export: start Compose with --profile pdf and turn on the pdf_export.enabled flag
Pdf__GotenbergUrl=http://gotenberg:3000
# Platform-wide job_enrichment tokens per Asia/Kolkata day; when reached, runs rank un-enriched jobs by rules.
# Leaving it empty removes the ceiling.
Ai__PlatformDailyEnrichmentTokenCeiling=2000000

# --- Matching and digest (M3) ---
Enrichment__MaxPerRun=60
Digest__WindowHours=4
Digest__MaxManualRunsPerDay=3
Digest__LookbackHours=72
Digest__EmailMaxItems=20

# --- Job sources (M2) ---
# Poll intervals live in job_sources.poll_interval_minutes (seed: Himalayas 1440, others 360; edit in Admin → Sources).
Sources__UserAgent=TailorlyRemote/1.0 (+https://tailorly.example)
Sources__TimeoutSeconds=15
Sources__CircuitOpenMinutes=60
Sources__DefaultRequestsPerMinute=60
# Per source, e.g. Sources__greenhouse__RequestsPerMinute=120
# Optional Himalayas API key for higher limits (Bearer); leave empty for the shared public allowance.
Sources__Himalayas__ApiKey=
Fetch__MaxPagesPerRun=50
Fetch__FirstRunBackfillDays=14
Fetch__BoardBulkDetailThreshold=25

# --- Admin ---
# Admin pages need two-step sign-in (TOTP) while true. Production forces it on (docker-compose.prod.yml).
Admin__RequireMfa=true
# An account with this email is granted the Admin role by `--migrate` / `--seed` once it is registered.
Admin__BootstrapEmail=

# --- Alerts (M6): emailed to every verified Admin, or to Alerts__To ---
Alerts__To=
Alerts__RepeatHours=6
Alerts__SourceConsecutiveFailures=3
Alerts__AiErrorRatePercent=10
Alerts__DiskUsedPercent=80
Alerts__BackupMaxAgeHours=26
# Production sets Alerts__CertificateHost=${SITE_ADDRESS} and Alerts__CertificateEndpoint=caddy:443 (docker-compose.prod.yml).
Alerts__CertificateMinDays=14

# --- Backups (deploy/backup.sh, deploy/sync-deletion-log.sh, deploy/restore-test.sh) ---
# age PUBLIC key; the private key stays off the VM (age-keygen -o tailorly-backup.key on your own machine).
BACKUP_AGE_RECIPIENT=
# rclone destination (configure the remote with `rclone config` on the VM), e.g. b2:tailorly-backups
BACKUP_REMOTE=
BACKUP_DIR=/var/backups/tailorly
BACKUP_RETENTION_DAYS=30
BACKUP_LOCAL_DAYS=3

# --- Deploy smoke test (deploy/deploy.sh): a verified, non-admin account used only for this ---
SMOKE_EMAIL=
SMOKE_PASSWORD=
