{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ats_analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["requirements", "title_seniority_label", "experience_relevance", "gaps"],
  "properties": {
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "type", "status", "evidence_paragraph_ids"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 200 },
          "type": { "type": "string", "enum": ["required", "preferred"] },
          "status": { "type": "string", "enum": ["met", "partial", "missing"] },
          "evidence_paragraph_ids": { "type": "array", "maxItems": 5, "items": { "type": "string", "pattern": "^p[0-9]{1,5}$" } }
        }
      }
    },
    "title_seniority_label": { "type": "number", "minimum": 0, "maximum": 1 },
    "experience_relevance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "justification"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "justification": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill", "likely_has_based_on_profile"],
        "properties": {
          "skill": { "type": "string", "minLength": 1, "maxLength": 80 },
          "likely_has_based_on_profile": { "type": "boolean" }
        }
      }
    }
  }
}
