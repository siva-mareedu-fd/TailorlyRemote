{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "interview_prep v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["technical_topics", "behavioural", "gaps_to_prepare", "questions_to_ask"],
  "properties": {
    "technical_topics": {
      "type": "array", "minItems": 2, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["topic", "why"],
        "properties": {
          "topic": { "type": "string", "minLength": 1, "maxLength": 200 },
          "why": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      }
    },
    "behavioural": {
      "type": "array", "minItems": 2, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["question", "talking_points_from_resume"],
        "properties": {
          "question": { "type": "string", "minLength": 1, "maxLength": 300 },
          "talking_points_from_resume": {
            "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 400 }
          }
        }
      }
    },
    "gaps_to_prepare": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "questions_to_ask": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 300 } }
  }
}
