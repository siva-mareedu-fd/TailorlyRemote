{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "job_fit_score v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["fit_score", "reasons", "matched_skills", "missing_skills", "confidence"],
  "properties": {
    "fit_score": { "type": "integer", "minimum": 1, "maximum": 10 },
    "reasons": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "matched_skills": { "type": "array", "maxItems": 40, "items": { "type": "string", "minLength": 1, "maxLength": 60 } },
    "missing_skills": { "type": "array", "maxItems": 40, "items": { "type": "string", "minLength": 1, "maxLength": 60 } },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
  }
}
