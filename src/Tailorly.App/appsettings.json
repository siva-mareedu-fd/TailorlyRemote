{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Consent": {
    "Version": "2026-10-1"
  },
  "App": {
    "PublicBaseUrl": "https://localhost"
  },
  "Ai": {
    "Provider": "Fake",
    "MaxConcurrentCalls": 4,
    "Effort": "low"
  },
  "Anthropic": {
    "MaxRetries": 3,
    "TimeoutSeconds": 120
  },
  "DeletionLog": {
    "Path": "deletion-log/deletions.log"
  },
  "Email": {
    "Provider": "Smtp",
    "From": "Tailorly Remote <no-reply@localhost>",
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "Security": "None"
    }
  },
  "Storage": {
    "Provider": "Local",
    "RootPath": "storage"
  },
  "Fx": {
    "Provider": "Static",
    "StaticRates": {
      "USD_INR": "84.0"
    }
  },
  "Hangfire": {
    "ServerEnabled": true,
    "WorkerCount": 4
  },
  "Signup": {
    "RequireInviteCode": false
  },
  "Budgets": {
    "DiscoveryTokens": 600000,
    "DocumentsTokens": 1400000
  }
}
