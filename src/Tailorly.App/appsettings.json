{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Consent": {
    "Version": "2026-10-1"
  },
  "App": {
    "PublicBaseUrl": "https://localhost"
  },
  "Ai": {
    "Provider": "Fake",
    "MaxConcurrentCalls": 4,
    "Effort": "low",
    "PlatformDailyEnrichmentTokenCeiling": 2000000
  },
  "Anthropic": {
    "MaxRetries": 3,
    "TimeoutSeconds": 120
  },
  "DeletionLog": {
    "Path": "deletion-log/deletions.log"
  },
  "Email": {
    "Provider": "Smtp",
    "From": "Tailorly Remote <no-reply@localhost>",
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "Security": "None"
    }
  },
  "Storage": {
    "Provider": "Local",
    "RootPath": "storage"
  },
  "Fx": {
    "Provider": "Frankfurter",
    "CacheHours": 12,
    "StaticRates": {
      "USD_INR": "95.0"
    }
  },
  "Hangfire": {
    "ServerEnabled": true,
    "WorkerCount": 4
  },
  "Signup": {
    "RequireInviteCode": false
  },
  "Budgets": {
    "DiscoveryTokens": 600000,
    "DocumentsTokens": 1400000
  },
  "Enrichment": {
    "MaxPerRun": 60,
    "Parallelism": 4
  },
  "Scoring": {
    "MaxPerRun": 20,
    "Parallelism": 4
  },
  "Digest": {
    "WindowHours": 4,
    "RetryDelayMinutes": [ 10, 30, 60 ],
    "MaxManualRunsPerDay": 3,
    "LookbackHours": 72,
    "EmailMaxItems": 20
  },
  "Tailor": {
    "MaxLengthRatio": 1.15,
    "MaxEdits": 25,
    "AllowFirstPerson": false
  },
  "Ats": {
    "Weights": {
      "KeywordCoverage": 0.35,
      "RequirementsMatch": 0.25,
      "TitleSeniority": 0.10,
      "ExperienceRelevance": 0.15,
      "FormatHealth": 0.15
    }
  },
  "CoverLetter": {
    "Tones": {
      "concise": 180,
      "confident": 250
    }
  },
  "Pdf": {
    "GotenbergUrl": "http://gotenberg:3000",
    "TimeoutSeconds": 60
  }
}
