{
  "openapi": "3.1.1",
  "info": {
    "title": "Tailorly Remote API",
    "version": "v1"
  },
  "paths": {
    "/api/v1/meta": {
      "get": {
        "tags": [
          "Meta"
        ],
        "operationId": "GetMeta",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/csrf": {
      "get": {
        "tags": [
          "Auth"
        ],
        "operationId": "GetCsrfToken",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MetaLimits": {
        "required": [
          "resumeMaxMb",
          "watchlistMax"
        ],
        "type": "object",
        "properties": {
          "resumeMaxMb": {
            "type": "integer",
            "format": "int32"
          },
          "watchlistMax": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "MetaResponse": {
        "required": [
          "version",
          "consentVersion",
          "requireInviteCode",
          "tones",
          "limits"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "consentVersion": {
            "type": "string"
          },
          "requireInviteCode": {
            "type": "boolean"
          },
          "tones": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limits": {
            "$ref": "#/components/schemas/MetaLimits"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Meta"
    },
    {
      "name": "Auth"
    }
  ]
}