{
  "openapi": "3.1.1",
  "info": {
    "title": "Tailorly Remote API",
    "version": "v1"
  },
  "paths": {
    "/api/v1/meta": {
      "get": {
        "tags": [
          "Meta"
        ],
        "operationId": "GetMeta",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 7807)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/csrf": {
      "get": {
        "tags": [
          "Auth"
        ],
        "operationId": "GetCsrfToken",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "Error (RFC 7807)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiProblem": {
        "required": [
          "type",
          "title",
          "status",
          "code",
          "traceId"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "code": {
            "type": "string",
            "description": "Stable error code (ApiDesign §10)"
          },
          "detail": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "extra": {
            "type": "object"
          }
        }
      },
      "MetaLimits": {
        "required": [
          "resumeMaxMb",
          "watchlistMax"
        ],
        "type": "object",
        "properties": {
          "resumeMaxMb": {
            "type": "integer",
            "format": "int32"
          },
          "watchlistMax": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "MetaResponse": {
        "required": [
          "version",
          "consentVersion",
          "requireInviteCode",
          "tones",
          "limits"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "consentVersion": {
            "type": "string"
          },
          "requireInviteCode": {
            "type": "boolean"
          },
          "tones": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limits": {
            "$ref": "#/components/schemas/MetaLimits"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Meta"
    },
    {
      "name": "Auth"
    }
  ]
}